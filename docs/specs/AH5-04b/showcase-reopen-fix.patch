+def reopen_dependency_graph(feature_dir: pathlib.Path, doc: dict[str, Any],
+                            state: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    """Dependencies for descendant invalidation without validating unrelated legacy packets.
+
+    A replanned task's active revision may change its dependencies, so it must resolve (fail closed). A legacy task
+    has no revision: its dependencies are the validated current DAG, which is what its active contract would return;
+    its historical packet file is not needed to find descendants and is left untouched.
+    """
+    graph = {}
+    for tid, task in task_index(doc).items():
+        if state['tasks'].get(tid, {}).get('active_packet_revision') is not None:
+            graph[tid] = active_task_contract(feature_dir, doc, tid, state=state)
+        else:
+            graph[tid] = task
+    return graph
+
