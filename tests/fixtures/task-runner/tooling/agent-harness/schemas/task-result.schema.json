{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic SDD task result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "summary",
    "changed_paths",
    "commands",
    "assumptions",
    "residual_risks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs-human",
        "verification-blocked",
        "verification-owned"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rework_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "tdd_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "green",
        "refactor"
      ],
      "properties": {
        "red": {
          "type": "string",
          "minLength": 1
        },
        "green": {
          "type": "string",
          "minLength": 1
        },
        "refactor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
