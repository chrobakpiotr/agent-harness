{
  "schema_version": 1,
  "gates": [
    {
      "id": "agent-harness-tests",
      "description": "Exercise the repository-local harness and verification authority regressions.",
      "command": "python3 -m unittest discover -s tooling/agent-harness/tests -p test_*.py",
      "inputs": [
        "tooling/agent-harness/**",
        "docs/specs/SDD-OBS-001/**",
        "docs/agentic-sdd/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "applicability": [
        "tooling/agent-harness/**",
        "docs/specs/SDD-OBS-001/**",
        "docs/agentic-sdd/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "mandatory": true,
      "cacheable": false,
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "harness-tests"
    },
    {
      "id": "agentic-sdd-doctor",
      "description": "Validate local task, state, and feature lifecycle invariants.",
      "command": "python3 tooling/agent-harness/harness.py doctor",
      "inputs": [
        "tooling/agent-harness/**",
        "docs/specs/**",
        "docs/agentic-sdd/**",
        "docs/**",
        "README.md",
        "AGENTS.md",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "applicability": [
        "tooling/agent-harness/**",
        "docs/specs/**",
        "docs/agentic-sdd/**",
        "docs/**",
        "README.md",
        "AGENTS.md",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "mandatory": true,
      "cacheable": false,
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "harness-validation"
    },
    {
      "id": "showcase-gradle-build",
      "description": "Build the Java modular monolith with its configured coverage and static quality checks.",
      "command": "./gradlew build --continue",
      "inputs": [
        "build.gradle",
        "settings.gradle",
        "gradle.properties",
        "gradle/**",
        "**/*.gradle",
        "**/*.gradle.kts",
        "**/*.java",
        "**/*.kt",
        "**/*.properties",
        "**/*.yml",
        "**/*.yaml",
        "tooling/quality/**",
        "modules/**",
        "apps/ecommerce/backend/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle.kts",
        "settings.gradle.kts",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "applicability": [
        "**/*.gradle",
        "**/*.gradle.kts",
        "**/*.java",
        "gradle/**",
        "settings.gradle",
        "modules/**",
        "apps/ecommerce/backend/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle.kts",
        "gradle.properties",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "mandatory": true,
      "cacheable": false,
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "application-build"
    },
    {
      "id": "showcase-frontend-build",
      "description": "Compile the Angular storefront using its checked-in dependency lock and build configuration.",
      "command": "npm run build",
      "cwd": "apps/ecommerce/frontend",
      "inputs": [
        "apps/ecommerce/frontend/package.json",
        "apps/ecommerce/frontend/package-lock.json",
        "apps/ecommerce/frontend/angular.json",
        "apps/ecommerce/frontend/tsconfig*.json",
        "apps/ecommerce/frontend/src/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json",
        "apps/ecommerce/frontend/**"
      ],
      "applicability": [
        "apps/ecommerce/frontend/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json"
      ],
      "mandatory": true,
      "cacheable": false,
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "frontend-build"
    },
    {
      "id": "domain-mutation-threshold",
      "description": "Enforce the domain module's configured 100 percent mutation threshold.",
      "command": "./tooling/scripts/verify-domain-pitest.sh",
      "inputs": [
        "modules/domain/**",
        "modules/foundation/**",
        "tooling/quality/pitest/pitest.gradle",
        "tooling/scripts/verify-domain-pitest.sh",
        "tooling/scripts/verify_pit_report.py",
        "build.gradle",
        "settings.gradle",
        "gradle/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle.kts",
        "settings.gradle.kts",
        "gradle.properties",
        "tooling/agent-harness/verification-profiles/showcase.json",
        "tooling/scripts/tests/test_verify_pit_report.py"
      ],
      "applicability": [
        "modules/domain/**",
        "tooling/scripts/verify-domain-pitest.sh",
        "modules/foundation/**",
        "tooling/quality/pitest/pitest.gradle",
        "tooling/scripts/verify_pit_report.py",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json",
        "tooling/scripts/tests/test_verify_pit_report.py"
      ],
      "mandatory": true,
      "cacheable": false,
      "critical": true,
      "retry_policy": "forbid",
      "retry_controls": [],
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "mutation-testing"
    },
    {
      "id": "critical-postgres-regression",
      "description": "Run the explicit retry-free critical Postgres recovery and concurrency suites.",
      "command": "./tooling/scripts/verify-critical-postgres-tests.sh",
      "inputs": [
        "tooling/quality/critical-postgres-manifest.json",
        "tooling/scripts/verify-critical-postgres-tests.sh",
        "tooling/scripts/verify_critical_postgres_results.py",
        "apps/ecommerce/backend/src/**",
        "apps/ecommerce/backend/ecommerce.gradle",
        "build.gradle",
        "settings.gradle",
        "gradle/**",
        "modules/adapters/persistence/**",
        "modules/domain/**",
        "modules/foundation/**",
        "apps/ecommerce/backend/**",
        "gradlew",
        "gradlew.bat",
        "build.gradle.kts",
        "settings.gradle.kts",
        "gradle.properties",
        "tooling/agent-harness/verification-profiles/showcase.json",
        "tooling/scripts/tests/test_verify_critical_postgres_results.py",
        "modules/application/orchestration/**"
      ],
      "applicability": [
        "tooling/quality/critical-postgres-manifest.json",
        "apps/ecommerce/backend/src/**",
        "modules/adapters/persistence/**",
        "modules/domain/**",
        "modules/foundation/**",
        "apps/ecommerce/backend/**",
        "tooling/scripts/verify-critical-postgres-tests.sh",
        "tooling/scripts/verify_critical_postgres_results.py",
        "gradlew",
        "gradlew.bat",
        "build.gradle",
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "tooling/agent-harness/verification-profiles/showcase.json",
        "tooling/scripts/tests/test_verify_critical_postgres_results.py",
        "modules/application/orchestration/**"
      ],
      "mandatory": true,
      "cacheable": false,
      "critical": true,
      "retry_policy": "forbid",
      "retry_controls": ["critical-postgres-gate-disables-gradle-test-retry-v1"],
      "sandbox": "required",
      "independent_execution_classes": ["harness-managed-independent-execution-v1"],
      "category": "critical-integration"
    },
    {
      "id": "critical-rabbitmq-regression",
